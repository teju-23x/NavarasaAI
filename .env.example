# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION (Required for Google OAuth via Supabase)
# Find these in your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# NOTE ON GOOGLE OAUTH CREDENTIALS:
# Google Client ID and Google Client Secret must NOT be placed in this frontend .env file!
# Instead, enter them directly in your Supabase Dashboard:
# Supabase Dashboard -> Authentication -> Providers -> Google
